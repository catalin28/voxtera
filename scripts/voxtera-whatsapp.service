[Unit]
# Voxtera WhatsApp channel — one async service for BOTH text concierge and
# voice calls. Text → ConciergePipeline; calls → Pipecat WhatsApp WebRTC bot
# (src/voxtera/whatsapp/call_bot.py). Listens on WHATSAPP_PORT (default 8200);
# the reverse proxy routes voxtera.io/whatsapp/* here.
Description=Voxtera WhatsApp channel (text + voice calls)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voxtera
WorkingDirectory=/opt/voxtera/app
EnvironmentFile=/etc/voxtera/voxtera.env
Environment=WHATSAPP_PORT=8200
# uv runs the project venv; falls back to `python -m voxtera.whatsapp` if you
# manage the venv yourself.
ExecStart=/usr/bin/env uv run python -m voxtera.whatsapp
Restart=always
RestartSec=3
# WebRTC needs UDP egress/ingress on the host's public IP — ensure the droplet
# firewall allows UDP (DigitalOcean default-open unless a cloud firewall blocks it).

[Install]
WantedBy=multi-user.target
