# Voxtera environment variables
# Copy this file to `.env` and fill in real values.
# `.env` MUST NEVER be committed to git (already in .gitignore).

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxx-replace-me

# --- STT + fallback TTS ---
OPENAI_API_KEY=sk-xxx-replace-me

# --- Logging ---
LOG_LEVEL=INFO

# --- Bot config ---
BOT_NAME=Voxtera
DEFAULT_TTS_VOICE=nova

# Voice activity detection. Pipecat's library defaults (min_volume=0.6,
# confidence=0.7) are tuned for headset mics; built-in laptop mics typically
# need both lower. Tune here if VAD never fires (try lower min_volume) or
# fires on background noise (raise confidence).
#   stop_secs    — silence duration that ends a turn
#   start_secs   — speech duration that begins a turn
#   min_volume   — 0.0 to 1.0; minimum RMS audio level to consider speech
#   confidence   — 0.0 to 1.0; Silero model confidence threshold
VAD_STOP_SECS=0.2
VAD_START_SECS=0.2
VAD_MIN_VOLUME=0.02
VAD_CONFIDENCE=0.5

# Optional RNNoise denoiser (demo-friendly): filters mic audio before VAD/STT.
# Set true for noisy environments; keep false if you want minimum CPU usage.
RNNOISE_ENABLED=false

# Whether user speech can interrupt/cancel in-flight bot responses.
# Keep false in noisy rooms to prevent <empty> replies from interruption storms.
ALLOW_INTERRUPTIONS=false

# Greeting language at startup: "auto" detects from OS locale; otherwise pass
# a 2-letter code (en, fr, es, it, de, pt, nl, ja, zh, ko, ar, ru, az, tr). Once the
# user speaks, Claude replies in the user's language regardless of this.
GREETING_LANGUAGE=auto

# How the user provides input.
#   voice  -> microphone only (the original behaviour)
#   text   -> keyboard only (mic disabled — useful in libraries or quiet places)
#   hybrid -> both (default; speak or type per turn)
# In all modes, the bot's reply still plays through the speakers/headphones.
INPUT_MODE=hybrid

# Audio transport backend.
#   local -> laptop mic/speakers
#   daily -> Daily WebRTC room transport
TRANSPORT_MODE=local

# --- RAG (Retrieval-Augmented Generation) ---
# Set to true to inject hotel knowledge into the LLM context before each turn.
# Requires content to be ingested first via `voxtera ingest`.
RAG_ENABLED=false
# Which hotel's knowledge base to use (matches the --hotel flag in voxtera ingest).
HOTEL_ID=demo

# --- Daily WebRTC ---
# Used later for browser-based voice transport.
DAILY_API_KEY=
DAILY_DOMAIN=
DAILY_ROOM_NAME=
