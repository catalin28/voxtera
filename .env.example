# Voxtera environment variables
# Copy this file to `.env` and fill in real values.
# `.env` MUST NEVER be committed to git (already in .gitignore).

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxx-replace-me

# --- STT + fallback TTS ---
OPENAI_API_KEY=sk-xxx-replace-me

# --- STT provider selection ---
# Which STT to use at startup: whisper | deepgram | gladia | google
# In daily transport mode all three are built when their credentials are
# present, and the active one can be switched from the demo UI at runtime.
STT_PROVIDER=whisper

# --- TTS provider selection ---
# Which TTS to use at startup: openai | google | cartesia | elevenlabs
# - openai     → OpenAI tts-1 (voices: nova, alloy, echo, fable, ...)
# - google     → Google Chirp 3 HD streaming (voices: en-US-Chirp3-HD-Charon, ...)
# - cartesia   → Cartesia Sonic-3 streaming (90ms TTFA, 42 languages — voice
#                IDs from https://play.cartesia.ai/voices)
# - elevenlabs → ElevenLabs Flash v2.5 streaming (75ms TTFA, 32 languages,
#                premium voice quality — voice IDs from
#                https://elevenlabs.io/app/voice-library)
# In daily transport mode all providers with credentials are built; the
# active one can be switched from the demo UI at runtime.
TTS_PROVIDER=openai

# --- Optional STT/TTS credentials ---
# Required for stt_provider=deepgram.
DEEPGRAM_API_KEY=
# Required for stt_provider=gladia (Solaria-1, 99+ languages with native
# code-switching). Get a key at https://app.gladia.io (10h/month free).
GLADIA_API_KEY=
# Gladia region: "eu-west" (default) or "us-west". Pick whichever is closer
# to your deployment to minimise WebSocket round-trip time.
GLADIA_REGION=eu-west
# Gladia candidate language list. Empty = full 99-language auto-detect.
# Non-empty (recommended) = "detect within this set", one language per
# utterance from the listed codes — improves transcription accuracy per
# Gladia's docs. Example tourism list: en,es,fr,de,it,pt,zh,ja,ar,ru
GLADIA_LANGUAGES=
# Enable mid-utterance code-switching ("where is the gare?"). Requires
# GLADIA_LANGUAGES to contain >=2 codes — Gladia silently produces no
# transcripts if this is true with a single-language list.
GLADIA_CODE_SWITCHING=false
# Path to a Google Cloud service account JSON. Required for stt_provider=google
# AND for tts_provider=google (Chirp 3 HD).
GOOGLE_APPLICATION_CREDENTIALS=
# Required for tts_provider=cartesia. Get a key at https://play.cartesia.ai.
# Free tier = 20K credits/month + personal use only; Pro = $4/month + commercial.
CARTESIA_API_KEY=
# Sonic-3 = latest model (90ms TTFA, 42 languages). Override for snapshot
# pinning (e.g. "sonic-3-2026-01-12") in production.
CARTESIA_MODEL=sonic-3
# Required for tts_provider=elevenlabs. Get a key at https://elevenlabs.io.
# Pricing: Flash/Turbo = $0.05/1K chars; Multilingual v2/v3 = $0.10/1K chars.
# Free tier exists but limited; consider the Startup Grants Program for
# 33M free chars over 12 months: https://elevenlabs.io/startup-grants
ELEVENLABS_API_KEY=
# ElevenLabs TTS model. Only these support per-utterance language codes
# (required for AutoTTSLanguageSwitcher to work):
#   eleven_flash_v2_5  → 75ms TTFA, 32 languages, $0.05/1K chars (RECOMMENDED)
#   eleven_turbo_v2_5  → mid-tier latency/quality, same 32 languages
# Older models (eleven_multilingual_v2, eleven_v3) detect language from
# text and ignore the parameter — avoid for multilingual sessions.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Voice ID to use at boot. ElevenLabs voices are multilingual: a single
# voice handles all 32 languages. Browse https://elevenlabs.io/app/voice-library
# and copy a voice's ID (looks like a 20-char base64 string).
# Default = "Rachel" (calm, warm American English). Other curated options
# whitelisted in voxtera.tts._VALID_ELEVENLABS_TTS_VOICES:
#   21m00Tcm4TlvDq8ikWAM  → Rachel  (default — American, calm, warm)
#   pNInz6obpgDQGcFmaJgB  → Adam    (American, deep, mature, male)
#   goT3UYdM9bhm0n2lmKQx  → Edward  (British, dark, seductive, low)
#   hpp4J3VqNfWAUOO0d1Us  → Bella
#   cgSgspJ2msm6clMCkdW9  → Jessica
#   iP95p4xoKVk53GoZ742B  → Chris
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Voice ID is selected at runtime via the HTML voice combo (voxtera-voice
# message). The Python builder has a hardcoded fallback voice for boot.
# Set to false if the Cloud Text-to-Speech API is not yet enabled in your GCP
# project. This skips building the Google TTS branch entirely so no 403 errors
# appear in the logs. Enable once you activate the API at:
# https://console.developers.google.com/apis/api/texttospeech.googleapis.com
GOOGLE_TTS_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO

# --- Call recording ---
# Save a self-contained record of every call to logs/calls/<session_id>/.
# CALL_RECORDING_ENABLED writes record.json — a metadata header (providers,
# duration, languages, interruption count, LLM token usage, bot character
# total) plus a turn-by-turn transcript. It is rewritten after every turn so
# a record survives even if the process is killed.
CALL_RECORDING_ENABLED=true
# CALL_RECORD_AUDIO additionally captures the call audio as a stereo WAV
# (recording.wav — guest on the left channel, bot on the right). Set to false
# to keep transcripts + metadata without storing audio, e.g. for privacy.
# Has no effect when CALL_RECORDING_ENABLED=false.
CALL_RECORD_AUDIO=true

# --- Bot config ---
BOT_NAME=Voxtera
DEFAULT_TTS_VOICE=nova

# Voice activity detection. Pipecat's library defaults (min_volume=0.6,
# confidence=0.7) are tuned for headset mics; built-in laptop mics typically
# need both lower. Tune here if VAD never fires (try lower min_volume) or
# fires on background noise (raise confidence).
#   stop_secs    — silence duration that ends a turn
#   start_secs   — speech duration that begins a turn
#   min_volume   — 0.0 to 1.0; minimum RMS audio level to consider speech
#   confidence   — 0.0 to 1.0; Silero model confidence threshold
VAD_STOP_SECS=0.2
VAD_START_SECS=0.2
VAD_MIN_VOLUME=0.02
VAD_CONFIDENCE=0.5

# --- SmartTurn end-of-turn detector ---
# The SmartTurn ONNX model decides when the guest has finished speaking; its
# thread count dominates the STT->LLM latency gap. It is AUTO-DETECTED from
# the server's core count at startup — leave this UNSET (recommended) so the
# bot self-tunes to whatever box it is deployed on. Set an explicit value
# only to force one for testing/debugging.
# SMART_TURN_CPU_COUNT=

# SmartTurn hard fallback: max seconds of CONTINUOUS silence (counted from the
# VAD stop event) after which the turn is force-ended even if the SmartTurn
# model still predicts the guest is not finished. pipecat's default is 3.0s,
# and on turns where the model mispredicts "incomplete" the bot waits out this
# entire window — the sole cause of the ~3s stt->llm latency spikes seen in
# tracing. 2.0 caps that worst case while still tolerating ~2.6s of total
# silence (0.6s VAD + 2.0s here) before ending a turn. Lower toward 1.5 for
# snappier turns if testing shows no premature cut-offs; raise toward 3.0 for
# noisy phone lines or slow speakers.
SMART_TURN_STOP_SECS=2.0

# Optional RNNoise denoiser (demo-friendly): filters mic audio before VAD/STT.
# Set true for noisy environments; keep false if you want minimum CPU usage.
RNNOISE_ENABLED=false

# Whether user speech can interrupt/cancel in-flight bot responses.
# Keep false in noisy rooms to prevent <empty> replies from interruption storms.
ALLOW_INTERRUPTIONS=false

# --- Instant-acknowledgment filler ---
# When true, the bot plays a short, natural backchannel ("One moment.",
# "Let me check that.") the instant the guest stops speaking. It runs in
# PARALLEL with the LLM — it never delays the real answer — and paints over
# the STT->LLM->TTS silence gap so the bot feels responsive even at the
# ~2.5s end-to-end latency floor.
# The filler language is taken from the language the STT detected for that
# utterance, so it always matches the guest. Turns shorter than 3 words
# (e.g. "yes", "thank you") are skipped, and the same phrase never plays
# twice in a row. Languages without a curated filler pool play no filler
# rather than a wrong-language one.
# Curated languages: en, fr, es, it, de, pt, nl, ru, ro, tr, pl, hy.
# Note: while enabled, the trace dashboard's tts_ttft reflects the filler
# (which starts fast), not the real answer — expect that number to drop.
FILLER_ENABLED=false

# Greeting language at startup: "auto" detects from OS locale; otherwise pass
# a 2-letter code (en, fr, es, it, de, pt, nl, ja, zh, ko, ar, ru, az, tr). Once the
# user speaks, Claude replies in the user's language regardless of this.
GREETING_LANGUAGE=auto

# How the user provides input.
#   voice  -> microphone only (the original behaviour)
#   text   -> keyboard only (mic disabled — useful in libraries or quiet places)
#   hybrid -> both (default; speak or type per turn)
# In all modes, the bot's reply still plays through the speakers/headphones.
INPUT_MODE=hybrid

# Audio transport backend.
#   local -> laptop mic/speakers
#   daily -> Daily WebRTC room transport
TRANSPORT_MODE=local

# --- RAG (Retrieval-Augmented Generation) ---
# Set to true to inject hotel knowledge into the LLM context before each turn.
# Requires content to be ingested first via `voxtera ingest`.
RAG_ENABLED=false
# Which hotel's knowledge base to use (matches the --hotel flag in voxtera ingest).
HOTEL_ID=demo
# Number of chunks injected per turn. Lower = faster LLM TTFT, less context.
RAG_TOP_K=3
RAG_MIN_SCORE=0.25

# --- STT prompt ---
# Disabled by default. The English prompt biases Whisper toward English even
# when the user speaks another language, causing garbled transcripts for
# multilingual sessions. Enable only if your users exclusively speak English
# and you want hotel vocabulary hints (e.g. "Louvre" vs "lover").
STT_PROMPT_ENABLED=false
# Optional: override the default prompt text (only used when STT_PROMPT_ENABLED=true).
# STT_PROMPT=Hotel concierge conversation. Guest asking about rooms, breakfast...

# --- Daily WebRTC ---
# Used later for browser-based voice transport.
DAILY_API_KEY=
DAILY_DOMAIN=
DAILY_ROOM_NAME=

# --- Admin sessions monitor ---
# Operator-only token for the /admin.html page exposed by demo-hotel/serve.py.
# When unset, /api/admin/* endpoints return 503 and the page renders a
# "admin disabled" banner. Generate a random token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VOXTERA_ADMIN_TOKEN=

# --- Actions (Telegram tickets + interactive buttons) ---
# Set to true to register the create_ticket LLM tool, post tickets to a
# Telegram channel, and start the staff-button listener as a background task.
# When enabled, the bot recognises guest complaints/requests during a call
# and fires a structured ticket to the configured channel.
# Values: true | false
ACTIONS_ENABLED=false

# Required when ACTIONS_ENABLED=true.
# Bot token from BotFather. Format: <digits>:<token>
# Example: 123456789:AAAbbbCCCDDDeeeFFFgggHHHiiiJJJkkk
TELEGRAM_BOT_TOKEN=
# Optional override for ticket channel id.
# Preferred source is config/hotels/<hotel_id>.yaml -> telegram_channel_id.
# If you set this env var, use Telegram channel id format (usually -100...).
# Example: -1003718824790
TELEGRAM_CHANNEL_ID=
# Optional operator convenience link for joining/viewing the ticket channel.
# Not required by runtime logic; informational only.
# Example: https://t.me/+n2oYt7UTf403ZjRh
TELEGRAM_INVITE_LINK=

# Urgency-escalation thresholds (in seconds). Defaults are demo-friendly so
# colours visibly shift during a short demo. Production hotels would use
# longer windows like 300/900/1800 (5m/15m/30m).
VOXTERA_URGENCY_ATTENTION_SECS=60
VOXTERA_URGENCY_URGENT_SECS=180
VOXTERA_URGENCY_CRITICAL_SECS=360
# --- External information sources (Phase 4a) ---
# Three independent sources the bot can consult to answer guest questions:
#   - Tavily web search → live, time-sensitive lookups (weather, events, hours)
#   - YouTube Data API  → "show me a video of this hotel" requests
#   - Google Places API → "what do people say about this hotel?" (reviews)
#
# Each source is gated by TWO checks: an *_ENABLED flag below AND the
# presence of its API key. Either off → the matching LLM tool is not
# registered, so the model cannot call it (no hallucinated requests).
# Set a flag to `false` to silence a source even when its key is set,
# e.g. for cost control or to A/B test the bot with the source removed.

# --- Web search (Tavily) ---
# Tavily search API — powers the bot's web_search tool for live,
# time-sensitive questions (weather, today's events, holiday opening hours)
# that RAG and the model's own knowledge can't answer.
# Account: this key is subscribed under the "pokemon" account — noted here so
# it stays clear which Tavily login this key belongs to.
# Free tier: 1,000 searches/month, no credit card. Dashboard: https://app.tavily.com
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=

# --- YouTube videos (YouTube Data API v3) ---
# Powers the `find_hotel_videos` tool — when a guest asks "do you have a
# video of this hotel?" the bot searches YouTube for relevant tours, reviews,
# room walkthroughs, etc., and returns the top matches.
# Quota: 10,000 units/day free. search.list costs 100 units → 100 searches/day
# free. Get a key at https://console.cloud.google.com/apis/credentials after
# enabling "YouTube Data API v3" in the same project.
YOUTUBE_SEARCH_ENABLED=true
YOUTUBE_API_KEY=

# --- Hotel reviews (Google Places API New) ---
# Powers the `find_hotel_reviews` tool — fetches Google rating + up to 5
# most-recent reviews per hotel. Falls back to "I don't have review data
# for that property right now" if the place is unknown.
# Cost: ~$17 per 1k Place Details calls; first 200/mo free under the
# Google Maps Platform free credit. Enable both "Places API (New)" and
# "Geocoding API" in the same Google Cloud project as YouTube above to
# share billing & quota.
PLACES_SEARCH_ENABLED=true
GOOGLE_PLACES_API_KEY=

ZOHO_SMTP_USER=hello@voxtera.ai
ZOHO_SMTP_PASS=your-app-password
INQUIRY_NOTIFY_EMAIL=hello@voxtera.ai

# --- WhatsApp Business Cloud API (text concierge channel) ---
# Powers the inbound WhatsApp webhook (`python -m voxtera.whatsapp`): guests
# text the business number and the call-center ConciergePipeline answers,
# keyed by the sender's wa_id for per-contact memory + region persistence.
#
# Where each value comes from (Meta app dashboard > WhatsApp > API Setup):
#   ACCESS_TOKEN       permanent system-user token (Step "Generate permanent token")
#   PHONE_NUMBER_ID    the registered number's id (NOT the +E.164 number)
#   BUSINESS_ACCOUNT_ID  WABA id (informational)
#   APP_SECRET         App settings > Basic > App secret (validates webhook signature)
#   WEBHOOK_VERIFY_TOKEN  any random string you invent; paste the same value
#                         into Meta's webhook config (e.g. `openssl rand -hex 16`)
#   GRAPH_VERSION      Graph API version (default v25.0)
#   DEFAULT_REGION     seed region for the discovery concierge; leave empty to
#                      have the bot ask "which region?" on the first turn
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_DEFAULT_REGION=
WHATSAPP_PORT=8200

# --- Telegram DM chat bridge (client -> agent) ---
# Run with: python -m voxtera.telegram_chat
#
# Reuses the existing /api/chat backend. The bridge long-polls Telegram DMs,
# maps each chat_id to a backend session_id, and relays replies back.
#
# Keep this separate from ACTIONS_ENABLED: actions post staff tickets to a
# channel; TELEGRAM_CHAT_* handles guest/client two-way DM chat.
# Values: true | false
TELEGRAM_CHAT_ENABLED=false
# URL of the backend chat endpoint the bridge calls.
# Local/same-host deploy (recommended): http://127.0.0.1:8080/api/chat
# Remote deploy example: https://api.voxtera.ai/api/chat
TELEGRAM_CHAT_BACKEND_URL=http://127.0.0.1:8080/api/chat
# Optional model override sent to /api/chat.
# Typical values: gpt-4o-mini, gpt-4.1-mini. Leave default unless needed.
TELEGRAM_CHAT_MODEL=gpt-4o-mini
# Telegram long-poll timeout in seconds (>0). Typical: 15-60.
TELEGRAM_CHAT_POLL_TIMEOUT_SECS=30
# End-to-end HTTP timeout for Telegram and backend calls in seconds (>0).
# Typical: 30-120 depending on model latency.
TELEGRAM_CHAT_REQUEST_TIMEOUT_SECS=60
# Optional token/code forwarded as demo_token to /api/chat.
# Recommended in this repo because /api/chat enforces demo/free-message limits.
TELEGRAM_CHAT_DEMO_TOKEN=
# Optional staged rollout allow-list.
# Format: comma-separated Telegram chat IDs (integers).
# Empty = allow all chats that can message the bot.
# Example: 1543748981,987654321
TELEGRAM_CHAT_ALLOWED_IDS=
